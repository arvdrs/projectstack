{% extends "report_base.html.j2" %}
{% block title %}{{ run.scenario }} load test{% endblock %}
{% block style %}
.verdict-row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-top: 14px; }
.targets { color: var(--ink-2); font-size: 13.5px; }
.finding { border-top: 1px solid var(--grid); padding: 16px 0; }
.finding:first-of-type { border-top: 0; padding-top: 4px; }
.finding-head { display: flex; flex-wrap: wrap; gap: 6px 12px; align-items: baseline; }
.finding-n { color: var(--muted); font-weight: 600; font-variant-numeric: tabular-nums; }
.finding .when { color: var(--ink-2); font-size: 13px; margin: 4px 0 8px; }
.finding .means { margin: 8px 0 0; }
.finding .means b { color: var(--ink-2); font-weight: 600; }
dl.ev { display: grid; grid-template-columns: max-content 1fr; gap: 3px 16px; margin: 8px 0; font-size: 13px; }
dl.ev dt { color: var(--ink-2); }
dl.ev dd { margin: 0; font-variant-numeric: tabular-nums; }
.cause { padding: 12px 0; border-top: 1px solid var(--grid); }
.cause:first-of-type { border-top: 0; padding-top: 2px; }
.conf { display: inline-block; font-size: 12px; font-weight: 600; color: var(--ink-2); border: 1px solid var(--axis);
  border-radius: 999px; padding: 1px 9px; margin-left: 6px; white-space: nowrap; }
.cause p { margin: 4px 0; }
.label-cell { min-width: 140px; max-width: 360px; overflow-wrap: break-word; }
/* Timeline chart */
.tl-wrap { position: relative; overflow-x: auto; }
.tl { display: block; width: 100%; min-width: 560px; height: auto; font-family: inherit; }
.tl-line { fill: none; stroke: var(--series); stroke-width: 2; stroke-linejoin: round; stroke-linecap: round; }
.tl-dot { fill: var(--series); stroke: var(--surface); stroke-width: 2; }
.tl-grid { stroke: var(--grid); stroke-width: 1; }
.tl-base { stroke: var(--axis); stroke-width: 1; }
.tl-tick { fill: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
.tl-title { fill: var(--ink-2); font-size: 12px; font-weight: 600; }
.tl-band-steady { fill: var(--band); }
.tl-band-critical { fill: var(--critical); fill-opacity: .14; }
.tl-band-warning { fill: var(--warning); fill-opacity: .2; }
.tl-band-info { fill: var(--muted); fill-opacity: .14; }
.tl-band-label { fill: var(--ink-2); font-size: 11px; font-weight: 600; }
.tl-ref { stroke: var(--ink-2); stroke-width: 1; stroke-dasharray: 4 3; }
.tl-ref-label { fill: var(--ink-2); font-size: 11px; }
.tl-cross { stroke: var(--ink-2); stroke-width: 1; pointer-events: none; }
.tl-hit { fill: transparent; cursor: crosshair; outline: none; }
.tl-hit:focus-visible { stroke: var(--series); stroke-width: 1.5; }
.tl-tip { position: absolute; top: 0; pointer-events: none; background: var(--surface); color: var(--ink);
  border: 1px solid var(--border); border-radius: 8px; box-shadow: 0 4px 14px rgba(0,0,0,.12);
  padding: 8px 11px; font-size: 12.5px; line-height: 1.5; white-space: nowrap; }
.tl-tip strong { font-variant-numeric: tabular-nums; }
.tl-tip span { color: var(--ink-2); }
.tl-tip-head { color: var(--ink-2); font-size: 12px; margin-bottom: 2px; }
.chart-key { display: flex; flex-wrap: wrap; gap: 6px 16px; color: var(--ink-2); font-size: 12.5px; margin: 8px 0 0; }
.swatch { display: inline-block; width: 14px; height: 10px; border-radius: 2px; vertical-align: -1px; margin-right: 6px; }
{% endblock %}
{% block body %}
<header>
  <p class="eyebrow">Load test report · technical</p>
  <h1>{{ run.scenario }}</h1>
  <p class="meta">Run <code>{{ run.run_id }}</code>{% if run.tag %} · {{ run.tag }}{% endif %}
    · {{ run.start|day }} {{ run.start|clock }} to {{ run.end|clock }} · {{ run.duration_s|duration }}
    · {{ run.samples|num }} samples · peak {{ run.peak_users|num }} users</p>
  <div class="verdict-row">
    <span class="badge big {{ verdict.cls }}"><span class="badge-icon" aria-hidden="true">{{ verdict.icon }}</span>{{ verdict.label }}</span>
    {% if sla.defined %}<span class="targets">SLA: {{ sla.targets|join(" · ") }}</span>{% endif %}
  </div>
</header>

<section class="tiles">
{% for k, v, s in tiles %}
  <div class="tile"><div class="k">{{ k }}</div><div class="v">{{ v }}</div>{% if s %}<div class="s">{{ s }}</div>{% endif %}</div>
{% endfor %}
</section>

{% if unverified %}
<div class="callout" role="note">
  <strong>Check these figures.</strong> The AI-written text below cites {{ unverified|length }} number(s) that could not be matched to findings.json:
  <ul>{% for u in unverified %}<li>“{{ u.text }}” <span class="muted">({{ u.field }})</span></li>{% endfor %}</ul>
</div>
{% endif %}

<section class="card">
  <h2>Summary</h2>
  <p>{{ n.summary }}</p>
</section>

{% if sla.defined %}
<section class="card">
  <h2>SLA results</h2>
  <div class="scroll"><table>
    <thead><tr><th>Check</th><th>Scope</th><th class="n">Target</th><th class="n">Measured</th><th>Result</th></tr></thead>
    <tbody>
    {% for c in sla.get("checks") or [] %}
      <tr>
        <td>{{ c.metric }}</td>
        <td class="label-cell">{{ c.label or "All requests" }}</td>
        <td class="n">{{ c.target|value }} {{ c.unit }}</td>
        <td class="n">{{ c.actual|value }} {{ c.unit }}</td>
        <td>{% if c.passed %}<span class="badge good"><span class="badge-icon" aria-hidden="true">✓</span>Pass</span>{% else %}<span class="badge critical"><span class="badge-icon" aria-hidden="true">✕</span>Fail</span>{% endif %}</td>
      </tr>
    {% endfor %}
    </tbody>
  </table></div>
  {% if truncated.get("sla.checks") %}<p class="small muted">Showing {{ truncated["sla.checks"].shown }} of {{ truncated["sla.checks"].total }} checks: {{ truncated["sla.checks"].kept }}.</p>{% endif %}
  <p class="small muted">Measured over the steady state, {{ steady.start_offset_s|offset }} to {{ steady.end_offset_s|offset }}.</p>
</section>
{% endif %}

{% if baseline %}
<section class="card">
  <h2>Compared with the baseline</h2>
  {% if not baseline.found %}
  <p>No baseline: {{ baseline.note }}.</p>
  {% else %}
  <p>Baseline run <code>{{ baseline.run_id }}</code>{% if baseline.tag %} ({{ baseline.tag }}){% endif %}{% if baseline.created_at %}, analysed {{ baseline.created_at|day }}{% endif %}.
    Load: {{ baseline.load.baseline_users|num }} → {{ baseline.load.current_users|num }} users, {{ baseline.load.baseline_tps|num(1) }} → {{ baseline.load.current_tps|num(1) }} {{ baseline.load.kind }}s per second —
    {% if baseline.load.comparable %}comparable.{% else %}<strong>not comparable</strong> ({{ baseline.load.reason }}), so differences are not counted as regressions.{% endif %}</p>
  <p class="small muted">{{ baseline.summary.regressed }} regressed, {{ baseline.summary.improved }} improved, {{ baseline.summary.compared }} labels compared. Regression: p95 +{{ baseline.thresholds.p95_pct|value }}% and +{{ baseline.thresholds.p95_ms|value }} ms, or errors +{{ baseline.thresholds.err_pp|value }} percentage points{% if baseline.thresholds.min_samples %}, labels with at least {{ baseline.thresholds.min_samples|num }} samples{% endif %}.</p>
  {% for f in regressions %}
  <h3 style="margin-top:14px">{{ "p95 regressions" if f.evidence.metric == "p95_ms" else "Error-rate regressions" }}{% if f.evidence.count > f.evidence.labels|length %} (worst {{ f.evidence.labels|length }} of {{ f.evidence.count }}){% endif %}</h3>
  <div class="scroll"><table>
    {% if f.evidence.metric == "p95_ms" %}
    <thead><tr><th>Label</th><th>Kind</th><th class="n">Baseline p95</th><th class="n">Now</th><th class="n">Change</th></tr></thead>
    <tbody>{% for r in f.evidence.labels %}<tr><td class="label-cell">{{ r.label }}</td><td>{{ r.kind }}</td><td class="n">{{ r.p95_before|num }} ms</td><td class="n">{{ r.p95_after|num }} ms</td><td class="n">+{{ r.increase_pct|value }}%</td></tr>{% endfor %}</tbody>
    {% else %}
    <thead><tr><th>Label</th><th>Kind</th><th class="n">Baseline errors</th><th class="n">Now</th><th class="n">Change</th></tr></thead>
    <tbody>{% for r in f.evidence.labels %}<tr><td class="label-cell">{{ r.label }}</td><td>{{ r.kind }}</td><td class="n">{{ r.err_before|pct }}</td><td class="n">{{ r.err_after|pct }}</td><td class="n">+{{ r.increase_pp|value }} pt</td></tr>{% endfor %}</tbody>
    {% endif %}
  </table></div>
  {% endfor %}
  {% endif %}
</section>
{% endif %}

{% if server %}
<section class="card">
  <h2>Server metrics</h2>
  <p class="small muted">From {{ server.resources|map(attribute="provider")|unique|map("upper")|join(" and ") }} monitoring, {{ server.period_s // 60 }}-minute values for the run's window. Server findings are in the findings list below.</p>
  {% for r in server.resources if r.metrics %}
  <h3 style="margin-top:12px">{{ r.name }} <span class="muted small">· {{ r.type }}{% if r.role %} · {{ r.role }}{% endif %}</span></h3>
  <div class="scroll"><table>
    <thead><tr><th>Metric</th><th class="n">Steady-state average</th><th class="n">Peak</th><th>Peak at</th></tr></thead>
    <tbody>{% for m in r.metrics %}<tr><td>{{ m.label }}</td><td class="n">{{ server_value(m.steady_avg, m.unit) }}</td><td class="n">{{ server_value(m.max, m.unit) }}</td><td>{{ m.max_offset_s|offset }}</td></tr>{% endfor %}</tbody>
  </table></div>
  {% endfor %}
  {% if server.missing %}<p class="small muted">No data: {% for x in server.missing %}{{ x.resource }} {{ x.metric }} ({{ x.why }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
</section>
{% endif %}

<section class="card">
  <h2>Timeline</h2>
  {{ chart }}
  <div class="chart-key">
    {% if steady.get("source") != "full" %}<span><span class="swatch" style="background:var(--band)"></span>Steady state (statistics window)</span>{% endif %}
    {% for f in findings if f.type != "sla_breach" and f.start_offset_s is defined %}{% if loop.first %}<span>#n: finding window, shaded by severity</span>{% endif %}{% endfor %}
    <span>{{ doc.timeline.bucket_s }} s buckets{% if truncated.get("timeline") %} ({{ truncated.timeline.merge }}){% endif %}</span>
  </div>
  {% if n.timeline %}
  <h3 style="margin-top:16px">What happened</h3>
  <ul class="plain">{% for o in n.timeline %}<li>{{ o }}</li>{% endfor %}</ul>
  {% endif %}
  <details>
    <summary>Timeline as a table</summary>
    <div class="scroll"><table>
      <thead><tr><th>Time</th><th>UTC</th><th class="n">Users</th><th class="n">Requests/s</th><th class="n">p95 (ms)</th><th class="n">Errors</th><th class="n">Samples</th></tr></thead>
      <tbody>
      {% for p in timeline_rows %}
        <tr><td>{{ p.start|offset }}</td><td>{{ p.clock }}</td><td class="n">{{ p.users|num }}</td><td class="n">{{ p.tps|num(1) }}</td><td class="n">{{ p.p95|num }}</td><td class="n">{{ p.err|pct }}</td><td class="n">{{ p.samples|num }}</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
  </details>
</section>

{% for t in tables %}
<section class="card">
  <h2>{{ t.title }}</h2>
  <div class="scroll"><table>
    <thead><tr><th>Label</th><th class="n">Samples</th><th class="n">Avg</th><th class="n">p50</th><th class="n">p90</th><th class="n">p95</th><th class="n">p99</th><th class="n">Max</th><th class="n">Errors</th><th class="n">Per s</th>{% if sla.defined %}<th>SLA</th>{% endif %}</tr></thead>
    <tbody>
    {% for r in t.rows %}
      <tr>
        <td class="label-cell">{{ r.label }}</td>
        <td class="n">{{ r.samples|num }}</td><td class="n">{{ r.avg_ms|num }}</td><td class="n">{{ r.p50_ms|num }}</td>
        <td class="n">{{ r.p90_ms|num }}</td><td class="n">{{ r.p95_ms|num }}</td><td class="n">{{ r.p99_ms|num }}</td>
        <td class="n">{{ r.max_ms|num }}</td><td class="n">{{ r.error_pct|pct }}</td><td class="n">{{ r.tps|num(2) }}</td>
        {% if sla.defined %}<td>{% if r.label in failed_by_label %}<span class="status-fail">✕ {{ failed_by_label[r.label]|join(", ") }}</span>{% elif t.kind == "transaction" or not doc.labels.get("transaction") %}<span class="muted">✓</span>{% else %}<span class="muted">—</span>{% endif %}</td>{% endif %}
      </tr>
    {% endfor %}
    {% if t.overall %}
      <tr class="total">
        <td>All {{ t.title|lower }}</td>
        <td class="n">{{ t.overall.samples|num }}</td><td class="n">{{ t.overall.avg_ms|num }}</td><td class="n">{{ t.overall.p50_ms|num }}</td>
        <td class="n">{{ t.overall.p90_ms|num }}</td><td class="n">{{ t.overall.p95_ms|num }}</td><td class="n">{{ t.overall.p99_ms|num }}</td>
        <td class="n">{{ t.overall.max_ms|num }}</td><td class="n">{{ t.overall.error_pct|pct }}</td><td class="n">{{ t.overall.tps|num(2) }}</td>
        {% if sla.defined %}<td></td>{% endif %}
      </tr>
    {% endif %}
    </tbody>
  </table></div>
  <p class="small muted">Times in ms over the steady state. Percentiles are exact (JMeter Aggregate Report definition).{% if t.truncated %} Showing {{ t.truncated.shown }} of {{ t.truncated.total }} labels: {{ t.truncated.kept }}.{% endif %}</p>
</section>
{% endfor %}

<section class="card">
  <h2>Findings</h2>
  {% for f in findings %}
  <article class="finding">
    <div class="finding-head">
      <span class="finding-n">#{{ f.n }}</span>
      <span class="badge {{ f.severity }}"><span class="badge-icon" aria-hidden="true">{{ f.sev_icon }}</span>{{ f.sev_label }}</span>
      <h3>{{ f.title }}</h3>
    </div>
    <p class="when">{% if f.start_offset_s is defined %}{% if f.end_offset_s is defined %}{{ f.start_offset_s|offset }} to {{ f.end_offset_s|offset }}{% else %}from {{ f.start_offset_s|offset }}{% endif %}{% endif %}{% if f.labels %} · {{ f.labels|join(", ") }}{% endif %}</p>
    <p>{{ f.detail }}</p>
    {% if f.explanation %}<p class="means"><b>What it means:</b> {{ f.explanation }}</p>{% endif %}
    {% if f.mapping %}<p class="small"><b>Set by:</b></p><ul class="plain small">{% for line in f.mapping %}<li>{{ line }}</li>{% endfor %}</ul>{% endif %}
    <details>
      <summary>Evidence</summary>
      <dl class="ev">{% for k, v in f.evidence_rows %}<dt>{{ k }}</dt><dd>{{ v|value }}</dd>{% endfor %}</dl>
      {% for tb in f.evidence_tables %}
      <div class="scroll"><table>
        <thead><tr>{% for c in tb.cols %}<th>{{ c }}</th>{% endfor %}</tr></thead>
        <tbody>{% for row in tb.rows %}<tr>{% for v in row %}<td>{{ v|value }}</td>{% endfor %}</tr>{% endfor %}</tbody>
      </table></div>
      {% endfor %}
    </details>
  </article>
  {% else %}
  <p>No findings. The detectors that ran found no SLA breach, change point, error burst, saturation or load-generator problem.</p>
  {% endfor %}
  {% if skipped %}<p class="small muted">Not checked: {% for s in skipped %}{{ s.detector }} ({{ s.reason }}){% if not loop.last %}; {% endif %}{% endfor %}.</p>{% endif %}
</section>

{% if n.root_causes %}
<section class="card">
  <h2>Likely root causes</h2>
  {% for c in n.root_causes %}
  <div class="cause">
    <h3>{{ loop.index }}. {{ c.cause }} <span class="conf">{{ c.confidence|capitalize }} confidence</span></h3>
    {% if c.findings %}<p class="small muted">Explains finding{{ "s" if c.findings|length > 1 }} {% for i in c.findings %}#{{ i }}{% if not loop.last %}, {% endif %}{% endfor %}</p>{% endif %}
    <p>{{ c.reasoning }}</p>
    {% if c.how_to_confirm %}<p><b>To confirm:</b> {{ c.how_to_confirm }}</p>{% endif %}
  </div>
  {% endfor %}
</section>
{% endif %}

{% if n.next_tests %}
<section class="card">
  <h2>Recommended next tests</h2>
  <ol class="plain">{% for t in n.next_tests %}<li><b>{{ t.test }}</b>{% if t.why %} — {{ t.why }}{% endif %}</li>{% endfor %}</ol>
</section>
{% endif %}

{% if errors %}
<section class="card">
  <h2>Top errors</h2>
  <div class="scroll"><table>
    <thead><tr><th>Label</th><th>Code</th><th>Message</th><th class="n">Count</th><th>First</th><th>Last</th></tr></thead>
    <tbody>
    {% for e in errors %}
      <tr><td class="label-cell">{{ e.label }}</td><td>{{ e.response_code }}</td><td class="label-cell">{{ e.failure or e.response_message }}</td><td class="n">{{ e.count|num }}</td><td>{{ e.first_offset_s|offset }}</td><td>{{ e.last_offset_s|offset }}</td></tr>
    {% endfor %}
    </tbody>
  </table></div>
  <p class="small muted">Whole run, including ramp-up and ramp-down.</p>
</section>
{% endif %}

<footer>
  <p>Steady state: {{ steady.get("note") or (steady.start_offset_s|offset ~ " to " ~ steady.end_offset_s|offset) }}.</p>
  {% for w in doc.get("warnings") or [] %}<p>Data: {{ w }}.</p>{% endfor %}
  {% for note in notes %}<p>{{ note }}</p>{% endfor %}
  {% if truncated %}<p>findings.json was reduced to fit its size budget: {% for k, v in truncated.items() %}{{ k }}{% if not loop.last %}, {% endif %}{% endfor %}.</p>{% endif %}
  <p>Narrative: {% if narrative.source == "llm" %}written by {{ narrative.provider }} with prompt {{ narrative.prompt }}; {{ number_check }}.{% else %}rule-based (no AI){% if narrative.note %} — {{ narrative.note }}{% endif %}.{% endif %}
    Findings, verdict and figures come from deterministic detectors.</p>
  <p>Raw samples stayed in the results database; {% if narrative.source == "llm" %}the AI model received only findings.json ({{ doc.size_bytes|kib }}){% else %}nothing was sent to an AI service{% endif %}.</p>
  <p>Generated by ProjectStack · {{ generated_at }} · {{ doc.schema }}</p>
</footer>
{% endblock %}
{% block script %}<script>{{ chart_script }}</script>{% endblock %}
