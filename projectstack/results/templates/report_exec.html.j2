{% extends "report_base.html.j2" %}
{% block title %}{{ run.scenario }} test summary{% endblock %}
{% block style %}
main { max-width: 860px; }
.headline { font-size: 21px; line-height: 1.4; font-weight: 600; margin: 14px 0 0; }
.points li { margin: 8px 0; }
.action { border-left: 4px solid var(--series); }
.action h2 { margin-bottom: 6px; }
{% endblock %}
{% block body %}
<header>
  <p class="eyebrow">Load test summary</p>
  <h1>{{ run.scenario }}</h1>
  <p class="meta">{{ run.start|day }} · {{ run.duration_s|duration }} test{% if run.tag %} · {{ run.tag }}{% endif %} · run <code>{{ run.run_id }}</code></p>
  <p style="margin-top:14px"><span class="badge big {{ verdict.cls }}"><span class="badge-icon" aria-hidden="true">{{ verdict.icon }}</span>{{ verdict.label }}</span></p>
  <p class="headline">{{ n.headline }}</p>
</header>

<section class="tiles">
{% for k, v, s in tiles %}
  <div class="tile"><div class="k">{{ k }}</div><div class="v">{{ v }}</div>{% if s %}<div class="s">{{ s }}</div>{% endif %}</div>
{% endfor %}
</section>

{% if unverified %}
<div class="callout" role="note">
  <strong>Check these figures.</strong> The AI-written text cites {{ unverified|length }} number(s) that could not be matched to the test results:
  <ul>{% for u in unverified %}<li>“{{ u.text }}”</li>{% endfor %}</ul>
</div>
{% endif %}

<section class="card">
  <h2>Key points</h2>
  <ul class="plain points">{% for p in n.key_points %}<li>{{ p }}</li>{% endfor %}</ul>
</section>

<section class="card">
  <h2>Business impact</h2>
  <p>{{ n.business_impact }}</p>
</section>

<section class="card action">
  <h2>Recommended action</h2>
  <p>{{ n.recommended_action }}</p>
</section>

<footer>
  {% if sla.defined %}<p>Targets: {{ sla.targets|join(" · ") }}. Figures cover the steady state at full load.</p>{% endif %}
  <p>Summary {% if narrative.source == "llm" %}written by {{ narrative.provider }} ({{ narrative.prompt }}) from the test findings; {{ number_check }}{% else %}generated from the test findings without AI{% endif %}. The verdict and figures come from automated checks. The technical report has the details.</p>
  <p>Generated by ProjectStack · {{ generated_at }}</p>
</footer>
{% endblock %}
